{
  "name": "led-field-visits",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs --port 5174 --host 127.0.0.1",
    "build": "node scripts/run-vite.mjs build",
    "typecheck": "tsc --noEmit",
    "apk": "npm run build && npx cap sync android && node scripts/assemble-apk.mjs",
    "apk:release": "npm run build && npx cap sync android && node scripts/assemble-apk.mjs --release"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@zxing/browser": "0.1.5",
    "lucide-react": "1.49.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.3.6"
  }
}
